# OpenRouter key for the About chat (nythos-6 = z-ai/glm-5.3-flash). Without it the chat replies with content/chat/offline.md.
OPENROUTER_API_KEY=

# Upstash Redis, shared rate limits and the daily spend ceiling for the chat (src/features/chat/guards.ts). Added by
# the Vercel Marketplace integration with the REDIS_ prefix (UPSTASH_REDIS_REST_* and unprefixed KV_REST_API_* work
# too). Without them each server instance counts on its own.
REDIS_KV_REST_API_URL=
REDIS_KV_REST_API_TOKEN=
